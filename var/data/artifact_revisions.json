        "content": {
            "generatorType": "html_micro_module",
            "generatorTemplate": "short_overview",
            "language": "en",
            "title": "DataHawk Plugin for BASE3 Framework",
            "summary": "The DataHawk plugin extends the BASE3 framework with a schema-driven query engine for reporting and data access.",
            "sections": [
                {
                    "id": "section_1",
                    "template": "short_overview",
                    "title": "Features",
                    "body": "DataHawk offers a schema-driven query system with a JSON query format compiled by MysqlReportQueryCompiler. It supports various element/expression types such as field references, functions, window functions, operations, case statements, subqueries, and scalars. It also provides automatic join planning and aliasing support for stable column names in results.",
                    "interaction": {
                        "type": "reading",
                        "prompt": ""
                    }
                },
                {
                    "id": "section_2",
                    "template": "short_overview",
                    "title": "Sensitivity and Data Protection",
                    "body": "Tables and fields can be marked as sensitive in schema metadata. Compilation marks sensitivity in compiled statements, and QueryResult includes per-column sensitivity flags.",
                    "interaction": {
                        "type": "reading",
                        "prompt": ""
                    }
                },
                {
                    "id": "section_3",
                    "template": "short_overview",
                    "title": "Query Execution",
                    "body": "DataHawk executes queries via IQueryService, using BASE3 IDatabase for execution. It supports integrity validation for select results and provides write query metadata such as affected rows and insert id.",
                    "interaction": {
                        "type": "reading",
                        "prompt": ""
                    }
                },
                {
                    "id": "section_4",
                    "template": "short_overview",
                    "title": "Transactions",
                    "body": "DataHawk supports atomic multi-step operations using a transaction query type. If any failure occurs, the transaction is rolled back, and errors are propagated as exceptions.",
                    "interaction": {
                        "type": "reading",
                        "prompt": ""
                    }
                }
            ],
