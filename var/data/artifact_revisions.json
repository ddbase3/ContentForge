        "content": {
            "generatorType": "html_micro_module",
            "generatorTemplate": "faq",
            "language": "en",
            "title": "DataHawk Plugin for BASE3 Framework: FAQ",
            "summary": "The DataHawk plugin extends the BASE3 framework with a schema-driven query engine for reporting and data access. This FAQ provides insights into its features, query syntax, and more.",
            "sections": [
                {
                    "id": "section_1",
                    "template": "faq",
                    "title": "What is the DataHawk Plugin for BASE3 Framework?",
                    "body": "The DataHawk plugin extends the BASE3 framework with a schema-driven query engine for reporting and data access. Queries are defined as structured JSON arrays, compiled to SQL, and executed through the BASE3 IDatabase abstraction.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Read more about the DataHawk Plugin and its features."
                    }
                },
                {
                    "id": "section_2",
                    "template": "faq",
                    "title": "What features does the DataHawk Plugin offer?",
                    "body": "The DataHawk Plugin offers a schema-driven query system, JSON query format compiled by MysqlReportQueryCompiler, support for various element/expression types, automatic join planning, aliasing support for stable column names, and sensitivity and data protection features.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Explore the various features of the DataHawk Plugin."
                    }
                },
                {
                    "id": "section_3",
                    "template": "faq",
                    "title": "How does the DataHawk Plugin handle query execution?",
                    "body": "Query execution is handled via IQueryService, which uses the BASE3 IDatabase for execution. It includes integrity validation for select results, write queries for affected rows and insert IDs, and supports atomic multi-step operations using a transaction query type.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Learn about the query execution process in the DataHawk Plugin."
                    }
                },
                {
                    "id": "section_4",
                    "template": "faq",
                    "title": "What query types are supported by the DataHawk Plugin?",
                    "body": "The DataHawk Plugin supports various query types including SELECT, INSERT, DELETE, and TRANSACTION. Each query type has its own specific structure and parameters.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Understand the different query types supported by the DataHawk Plugin."
                    }
                },
                {
                    "id": "section_5",
                    "template": "faq",
                    "title": "What exporters are available in the DataHawk Plugin?",
                    "body": "The DataHawk Plugin provides several exporters including CSV, JSON, HTML, HTML-Mail, and Excel-HTML. Each exporter serves different use cases such as data analysis, API integration, web preview, email delivery, and Excel downloads.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Discover the various exporters available in the DataHawk Plugin and their use cases."
                    }
                }
            ],
