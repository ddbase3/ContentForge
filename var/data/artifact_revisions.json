        "type": "html_micro_module",
        "content": {
            "generatorType": "html_micro_module",
            "generatorTemplate": "micro_learning",
            "language": "en",
            "title": "DataHawk Plugin for BASE3 Framework",
            "summary": "An overview of the DataHawk plugin, its features, and usage within the BASE3 framework.",
            "sections": [
                {
                    "id": "section_1",
                    "template": "short_overview",
                    "title": "Introduction to DataHawk",
                    "body": "The DataHawk plugin extends the BASE3 framework with a schema-driven query engine for reporting and data access. Queries are defined as structured JSON arrays, compiled to SQL, and executed through the BASE3 IDatabase abstraction.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Read through the introduction to understand the basic functionality of DataHawk."
                    }
                },
                {
                    "id": "section_2",
                    "template": "checklist",
                    "title": "Key Features",
                    "body": "DataHawk offers several key features:",
                    "interaction": {
                        "type": "reflection",
                        "prompt": "Reflect on how these features might be useful in your projects."
                    },
                    "items": [
                        "Schema-driven query system",
                        "JSON query format compiled by MysqlReportQueryCompiler",
                        "Support for various element/expression types",
                        "Aliasing support for stable column names",
                        "Sensitivity and data protection",
                        "Schema management",
                        "Query execution and integrity validation",
                        "Support for write queries and transactions"
                    ]
                },
                {
                    "id": "section_3",
                    "template": "faq",
                    "title": "Query Syntax Examples",
                    "body": "Here are some examples of query syntax used in DataHawk:",
                    "interaction": {
                        "type": "question",
                        "prompt": "Which query type do you think you will use most frequently?"
                    },
                    "items": [
                        {
                            "question": "What is the basic structure of a SELECT query?",
                            "answer": "{ \"type\": \"select\", \"fields\": [...], \"from\": \"table_name\", ... }"
                        },
                        {
                            "question": "How do you perform an INSERT operation?",
                            "answer": "{ \"type\": \"insert\", \"table\": \"table_name\", \"values\": [...] }"
                        },
                        {
                            "question": "What does a DELETE query look like?",
