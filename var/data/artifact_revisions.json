        "content": {
            "generatorType": "html_micro_module",
            "generatorTemplate": "faq",
            "language": "en",
            "title": "DataHawk Plugin for BASE3 Framework: FAQ",
            "summary": "Frequently Asked Questions about the DataHawk Plugin for BASE3 Framework",
            "sections": [
                {
                    "id": "section_1",
                    "template": "faq",
                    "title": "What is the DataHawk Plugin for BASE3 Framework?",
                    "body": "The DataHawk plugin extends the BASE3 framework with a schema-driven query engine for reporting and data access. Queries are defined as structured JSON arrays, compiled to SQL, and executed through the BASE3 IDatabase abstraction.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Understand the basic functionality of DataHawk Plugin."
                    }
                },
                {
                    "id": "section_2",
                    "template": "faq",
                    "title": "What features does the DataHawk Plugin support?",
                    "body": "The DataHawk Plugin supports a schema-driven query system, JSON query format compiled by MysqlReportQueryCompiler, various element/expression types, automatic join planning, aliasing support for stable column names, and sensitivity and data protection markings.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Learn about the key features of DataHawk Plugin."
                    }
                },
                {
                    "id": "section_3",
                    "template": "faq",
                    "title": "How does the DataHawk Plugin handle schema management?",
                    "body": "The schema is provided by an IQuerySchemaProvider, with a default JSON-based provider. Table metadata includes joins, tags, categories, domains, and default filters.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Understand the schema management in DataHawk Plugin."
                    }
                },
                {
                    "id": "section_4",
                    "template": "faq",
                    "title": "What types of queries does the DataHawk Plugin support?",
                    "body": "The DataHawk Plugin supports SELECT, INSERT, DELETE, and TRANSACTION queries. Each type of query has a specific structure and supports various parameters and options.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Learn about the different types of queries supported by DataHawk Plugin."
                    }
                },
                {
                    "id": "section_5",
                    "template": "faq",
                    "title": "What exporters are available in the DataHawk Plugin?",
                    "body": "The DataHawk Plugin provides several exporters including CSV, JSON, HTML, HTML-Mail, and Excel-HTML. Each exporter serves different use cases such as data analysis, API integration, web preview, email delivery, and Excel downloads.",
                    "interaction": {
                        "type": "reading",
                        "prompt": "Understand the various exporters available in DataHawk Plugin."
                    }
                }
            ],
